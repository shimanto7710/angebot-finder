{
  "info": {
    "name": "AngebotFinder DE",
    "description": "Local API calls. Select the local environment, set name/email/password, then register (once), log in, and fetch your profile. Login saves the bearer token; registration and profile save user_id. Chat triggers local LLM inference and can be slow on first use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates an account and saves user_id. Skip if already registered; HTTP 409 means the email exists. No body-overriding pre-request script: edit the JSON body directly or fill the selected environment variables.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  pm.environment.set(\"user_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Saves access_token into the selected environment. Tokens expire after 30 minutes. No body-overriding pre-request script: edit the JSON body directly or fill the selected environment variables.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"access_token\", pm.response.json().access_token);",
                  "} else { pm.environment.unset(\"access_token\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "3. My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Uses the saved bearer token and updates user_id. Run after login, especially with an existing account. No body-overriding pre-request script: edit the JSON body directly or fill the selected environment variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  pm.environment.set(\"user_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Ask question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Automatically uses the last three saved turns for this user and saves the new question and answer. Requires prepared offers, embeddings and cached models.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"question\": \"{{question}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({\"user_id\": pm.variables.get(\"user_id\"), \"question\": pm.variables.get(\"question\")}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/chat/history?user_id={{user_id}}&limit=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chat",
                "history"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "3",
                  "disabled": false
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Offers",
      "item": [
        {
          "name": "List offers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/offers?limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "offers"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": false
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter offers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/offers?search=coffee&store=REWE&max_price=5&include_unsearchable=false&limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "offers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "coffee",
                  "disabled": false
                },
                {
                  "key": "store",
                  "value": "REWE",
                  "disabled": false
                },
                {
                  "key": "brand",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "min_price",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "max_price",
                  "value": "5",
                  "disabled": false
                },
                {
                  "key": "requires_loyalty",
                  "value": "false",
                  "disabled": true
                },
                {
                  "key": "include_unsearchable",
                  "value": "false",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": false
                }
              ]
            },
            "description": "Enable optional filters in Params. Empty results are valid; unknown loyalty does not match false.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Android data",
      "item": [
        {
          "name": "Download chunks and embeddings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rag/data",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rag",
                "data"
              ]
            },
            "description": "One JSON bundle with config, version, chunks and aligned vectors. Does not download model weights.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Vectors and chunks align\", () => {",
                  "    pm.expect(data.chunks.length).to.eql(data.embeddings.length);",
                  "    pm.expect(data.chunks.length).to.eql(data.config.chunk_count);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
